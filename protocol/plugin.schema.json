{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentect.dev/schema/plugin.v1.json",
  "title": "Pentect plugin protocol v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "id", "hook", "payload"],
      "properties": {
        "schema": { "const": "pentect.plugin.v1" },
        "id": { "type": "integer", "minimum": 1 },
        "hook": {
          "enum": ["prepare", "inspect", "finalize", "request", "response", "tool_call", "file"]
        },
        "payload": {},
        "metadata": {},
        "config": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "id", "type"],
      "properties": {
        "schema": { "const": "pentect.plugin.v1" },
        "id": { "type": "integer", "minimum": 1 },
        "type": { "const": "result" },
        "action": { "enum": ["next", "stop"] },
        "outcome": { "enum": ["block", "respond"] },
        "payload": {},
        "message": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" }
          },
          "additionalProperties": false
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "label"],
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 1 },
              "label": { "type": "string", "minLength": 1 },
              "category": { "enum": ["secret", "identifier", "endpoint", "pii", "other"] },
              "confidence": { "enum": ["high", "medium", "low"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
