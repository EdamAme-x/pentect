{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pentect.dev/schemas/plugin-project-lock.v1.json",
  "title": "Pentect project plugin lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plugin"],
  "properties": {
    "schema": { "const": "pentect.plugin-project-lock.v1" },
    "plugin": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "resolved", "files"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "resolved": {
            "type": "string",
            "pattern": "^https://raw\\.githubusercontent\\.com/"
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
