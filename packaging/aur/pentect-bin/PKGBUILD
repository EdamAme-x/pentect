# Maintainer: EdamAme-x <edame8080 at gmail dot com>
pkgname=pentect-bin
pkgver=0.0.68
pkgrel=1
pkgdesc='Local secret masking boundary for AI agents (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/EdamAme-x/pentect'
license=('MIT')
depends=('ca-certificates' 'gcc-libs' 'glibc')
provides=("pentect=$pkgver")
conflicts=('pentect')
options=('!strip')
source=(
  'pentect-LICENSE::https://github.com/EdamAme-x/pentect/releases/download/v0.0.68/LICENSE'
  'pentect-THIRD_PARTY_LICENSES.txt::https://github.com/EdamAme-x/pentect/releases/download/v0.0.68/THIRD_PARTY_LICENSES.txt'
)
sha256sums=(
  'c87936a4168b4cb93850c94a7f98e03e372145df0ecb3c90f7f02cd1a1fed248'
  '40efcb8a1fa5b5c81ee5f12e96dcb885d6103225fb8b1b6e64199cd8a98456bb'
)
source_x86_64=("pentect-${pkgver}-x86_64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.68/pentect-linux-x86_64")
sha256sums_x86_64=('3d4401afe42dd5524fdebfa471a95aa8c660b9218ccd0d54ce6ddaa608e3a5e5')
source_aarch64=("pentect-${pkgver}-aarch64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.68/pentect-linux-aarch64")
sha256sums_aarch64=('aeef1a74b012cd4397b88d1ab2348012ff81eb270511437ca7edbab9efeadac5')

package() {
  install -Dm755 "$srcdir/pentect-${pkgver}-${CARCH}" "$pkgdir/usr/bin/pentect"
  printf '%s\n' '{"version":1,"manager":"aur","uninstall":"sudo pacman -Rns pentect-bin"}' > "$pkgdir/usr/bin/.pentect-managed-install.json"
  install -Dm644 "$srcdir/pentect-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/pentect-THIRD_PARTY_LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.txt"
}
