# Maintainer: EdamAme-x <edame8080 at gmail dot com>
pkgname=pentect-bin
pkgver=0.0.96
pkgrel=1
pkgdesc='Local secret masking boundary for AI agents (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/EdamAme-x/pentect'
license=('MIT')
depends=('ca-certificates' 'gcc-libs' 'glibc')
provides=("pentect=$pkgver")
conflicts=('pentect')
options=('!strip')
source=(
  'pentect-LICENSE::https://github.com/EdamAme-x/pentect/releases/download/v0.0.96/LICENSE'
  'pentect-THIRD_PARTY_LICENSES.txt::https://github.com/EdamAme-x/pentect/releases/download/v0.0.96/THIRD_PARTY_LICENSES.txt'
)
sha256sums=(
  'c87936a4168b4cb93850c94a7f98e03e372145df0ecb3c90f7f02cd1a1fed248'
  '30d749bb0fd511d57ec8429420ae4b12980ef48bd15fb952af6c2aa2a32966ad'
)
source_x86_64=("pentect-${pkgver}-x86_64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.96/pentect-linux-x86_64")
sha256sums_x86_64=('e685e9e5749caa6912ca78dade4744911acc8f0dfb1877c1372651a73bfa3d6d')
source_aarch64=("pentect-${pkgver}-aarch64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.96/pentect-linux-aarch64")
sha256sums_aarch64=('77d21128cf4a9b44cefc72bcfbf86d0458186b76ca7a9bc0f9c086e486b1ef98')

package() {
  install -Dm755 "$srcdir/pentect-${pkgver}-${CARCH}" "$pkgdir/usr/bin/pentect"
  printf '%s\n' '{"version":1,"manager":"aur","uninstall":"sudo pacman -Rns pentect-bin"}' > "$pkgdir/usr/bin/.pentect-managed-install.json"
  install -Dm644 "$srcdir/pentect-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/pentect-THIRD_PARTY_LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.txt"
}
