# Maintainer: EdamAme-x <edame8080 at gmail dot com>
pkgname=pentect-bin
pkgver=0.0.100
pkgrel=1
pkgdesc='Local secret masking boundary for AI agents (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/EdamAme-x/pentect'
license=('MIT')
depends=('ca-certificates' 'gcc-libs' 'glibc')
provides=("pentect=$pkgver")
conflicts=('pentect')
options=('!strip')
source=(
  'pentect-LICENSE::https://github.com/EdamAme-x/pentect/releases/download/v0.0.100/LICENSE'
  'pentect-THIRD_PARTY_LICENSES.txt::https://github.com/EdamAme-x/pentect/releases/download/v0.0.100/THIRD_PARTY_LICENSES.txt'
)
sha256sums=(
  'c87936a4168b4cb93850c94a7f98e03e372145df0ecb3c90f7f02cd1a1fed248'
  '30d749bb0fd511d57ec8429420ae4b12980ef48bd15fb952af6c2aa2a32966ad'
)
source_x86_64=("pentect-${pkgver}-x86_64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.100/pentect-linux-x86_64")
sha256sums_x86_64=('d25820bf5bd912f838e731487806e4008e2a667d5e2e6fd735c943595eb45004')
source_aarch64=("pentect-${pkgver}-aarch64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.100/pentect-linux-aarch64")
sha256sums_aarch64=('cffa59f762c1c5bcb8820d217959faaded61806c9a24cdd13d6b7d3189460fb7')

package() {
  install -Dm755 "$srcdir/pentect-${pkgver}-${CARCH}" "$pkgdir/usr/bin/pentect"
  printf '%s\n' '{"version":1,"manager":"aur","uninstall":"sudo pacman -Rns pentect-bin"}' > "$pkgdir/usr/bin/.pentect-managed-install.json"
  install -Dm644 "$srcdir/pentect-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/pentect-THIRD_PARTY_LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.txt"
}
