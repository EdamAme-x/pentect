# Maintainer: EdamAme-x <edame8080 at gmail dot com>
pkgname=pentect-bin
pkgver=0.0.85
pkgrel=1
pkgdesc='Local secret masking boundary for AI agents (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/EdamAme-x/pentect'
license=('MIT')
depends=('ca-certificates' 'gcc-libs' 'glibc')
provides=("pentect=$pkgver")
conflicts=('pentect')
options=('!strip')
source=(
  'pentect-LICENSE::https://github.com/EdamAme-x/pentect/releases/download/v0.0.85/LICENSE'
  'pentect-THIRD_PARTY_LICENSES.txt::https://github.com/EdamAme-x/pentect/releases/download/v0.0.85/THIRD_PARTY_LICENSES.txt'
)
sha256sums=(
  'c87936a4168b4cb93850c94a7f98e03e372145df0ecb3c90f7f02cd1a1fed248'
  'e065be42636ccb4a050da7ae8c6eed74839ef52e67148c6b3ec4862cb7e0f947'
)
source_x86_64=("pentect-${pkgver}-x86_64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.85/pentect-linux-x86_64")
sha256sums_x86_64=('7b3601238322aebf834d07d1d29ff9a65b794055fb524c7ec1b1360d8c3e9f91')
source_aarch64=("pentect-${pkgver}-aarch64::https://github.com/EdamAme-x/pentect/releases/download/v0.0.85/pentect-linux-aarch64")
sha256sums_aarch64=('73a21d5959c6d4071ca1aec87378f9db6961305948858f69c3fdce98f8276e05')

package() {
  install -Dm755 "$srcdir/pentect-${pkgver}-${CARCH}" "$pkgdir/usr/bin/pentect"
  printf '%s\n' '{"version":1,"manager":"aur","uninstall":"sudo pacman -Rns pentect-bin"}' > "$pkgdir/usr/bin/.pentect-managed-install.json"
  install -Dm644 "$srcdir/pentect-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/pentect-THIRD_PARTY_LICENSES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.txt"
}
