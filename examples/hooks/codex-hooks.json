{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pentect hook codex",
            "commandWindows": "& pentect hook codex",
            "timeout": 30,
            "statusMessage": "Pentect resolving masked tool input"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pentect hook codex",
            "commandWindows": "& pentect hook codex",
            "timeout": 30,
            "statusMessage": "Pentect masking tool output"
          }
        ]
      }
    ]
  }
}
