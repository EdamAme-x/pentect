{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "pentect-resolve-tool-input",
            "type": "command",
            "command": "pentect hook --capability gemini",
            "timeout": 30000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "pentect-mask-tool-output",
            "type": "command",
            "command": "pentect hook --capability gemini",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
