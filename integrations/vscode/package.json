{
  "name": "pentect-vscode",
  "displayName": "Pentect",
  "description": "Use an AI model through Pentect's local secret boundary.",
  "version": "0.0.1",
  "publisher": "pentect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EdamAme-x/pentect.git",
    "directory": "integrations/vscode"
  },
  "homepage": "https://pentect.dev/clients/vscode/",
  "bugs": {
    "url": "https://github.com/EdamAme-x/pentect/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ai-security",
    "secrets",
    "language-model-provider"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "pentect",
        "displayName": "Pentect",
        "managementCommand": "pentect.manageProvider"
      }
    ],
    "commands": [
      {
        "command": "pentect.manageProvider",
        "title": "Pentect: Configure Language Model Provider"
      },
      {
        "command": "pentect.restartProvider",
        "title": "Pentect: Restart Language Model Provider"
      }
    ],
    "configuration": {
      "title": "Pentect",
      "properties": {
        "pentect.executablePath": {
          "type": "string",
          "default": "pentect",
          "scope": "machine",
          "description": "Pentect executable. Arguments are never accepted here."
        },
        "pentect.vscode.model": {
          "type": "string",
          "default": "gpt-5",
          "scope": "machine",
          "description": "OpenAI-compatible model exposed by the Pentect provider."
        },
        "pentect.vscode.upstream": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional OpenAI-compatible upstream base URL. Credentials stay in Pentect's environment."
        }
      }
    }
  },
  "scripts": {
    "check": "npm run compile && npm test",
    "compile": "tsc -p ./",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run compile --silent && node test/provider-e2e.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce@3.6.0 package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/vscode": "1.104.0",
    "typescript": "5.9.2"
  }
}
