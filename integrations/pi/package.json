{
  "name": "@pentect/pi",
  "version": "0.0.0",
  "description": "Pentect provider extension for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akagumi-Inc/pentect.git",
    "directory": "integrations/pi"
  },
  "homepage": "https://pentect.dev/clients/pi/",
  "bugs": "https://github.com/Akagumi-Inc/pentect/issues",
  "publishConfig": {
    "access": "public"
